{
  "name": "voyage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:assets": "node scripts/check-assets.mjs",
    "check:brand": "node scripts/check-branding.mjs",
    "check:render": "node scripts/check-render-quality.mjs && node scripts/check-texture-sampling.mjs && node scripts/check-material-facing.mjs && node scripts/check-floating-hover.mjs"
  },
  "dependencies": {
    "draco3d": "^1.5.7",
    "gsap": "^3.14.2",
    "lottie-web": "^5.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/draco3d": "^1.4.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "latest",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.36.0"
  }
}
